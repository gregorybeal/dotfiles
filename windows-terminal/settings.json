{
    "$schema": "https://aka.ms/terminal-profiles-schema",

    "x-wslProfile": {
        "tabTitle": "WSL",
        "icon": "",
        "commandline": "wsl.exe -d {distro} --cd ~"
    },

    "copyOnSelect": true,
    "copyFormatting": "none",
    "confirmCloseAllTabs": false,
    "windowingBehavior": "useAnyExisting",
    "theme": "Catppuccin Mocha",

    "profiles": {
        "defaults": {
            "font": {
                "face": "FiraCode Nerd Font",
                "size": 12,
                "features": { "calt": 1, "liga": 1 }
            },
            "colorScheme": "Catppuccin Mocha",
            "cursorShape": "filledBox",
            "antialiasingMode": "cleartype",
            "padding": "10, 8",
            "historySize": 50000,
            "scrollbarState": "hidden",
            "bellStyle": "none",
            "opacity": 98,
            "useAcrylic": false,
            "intenseTextStyle": "bright"
        }
    },

    "keybindings": [
        { "id": "unbound", "keys": "ctrl+v" },
        { "id": "unbound", "keys": "alt+left" },
        { "id": "unbound", "keys": "alt+right" },
        { "id": "unbound", "keys": "alt+up" },
        { "id": "unbound", "keys": "alt+down" },
        { "id": "unbound", "keys": "alt+shift+left" },
        { "id": "unbound", "keys": "alt+shift+right" },
        { "id": "unbound", "keys": "alt+shift+up" },
        { "id": "unbound", "keys": "alt+shift+down" },
        { "id": "Terminal.PasteFromClipboard", "keys": "ctrl+shift+v" },
        { "id": "Terminal.CopyToClipboard", "keys": "ctrl+shift+c" }
    ],

    "schemes": [
        {
            "name": "Catppuccin Mocha",
            "cursorColor": "#F5E0DC",
            "selectionBackground": "#585B70",
            "background": "#1E1E2E",
            "foreground": "#CDD6F4",
            "black": "#45475A",
            "red": "#F38BA8",
            "green": "#A6E3A1",
            "yellow": "#F9E2AF",
            "blue": "#89B4FA",
            "purple": "#F5C2E7",
            "cyan": "#94E2D5",
            "white": "#BAC2DE",
            "brightBlack": "#585B70",
            "brightRed": "#F38BA8",
            "brightGreen": "#A6E3A1",
            "brightYellow": "#F9E2AF",
            "brightBlue": "#89B4FA",
            "brightPurple": "#F5C2E7",
            "brightCyan": "#94E2D5",
            "brightWhite": "#A6ADC8"
        }
    ],

    "themes": [
        {
            "name": "Catppuccin Mocha",
            "tab": {
                "background": "#1E1E2EFF",
                "showCloseButton": "hover",
                "unfocusedBackground": null
            },
            "tabRow": {
                "background": "#181825FF",
                "unfocusedBackground": "#11111BFF"
            },
            "window": {
                "applicationTheme": "dark",
                "useMica": false
            }
        }
    ]
}
